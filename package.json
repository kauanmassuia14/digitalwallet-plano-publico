{
  "name": "digitalwallet",
  "version": "0.1.0",
  "private": true,
  "description": "DigitalWallet circular packaging pilot",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": "11.1.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @digitalwallet/database generate",
    "db:migrate": "pnpm --filter @digitalwallet/database migrate:dev",
    "db:validate": "pnpm --filter @digitalwallet/database validate",
    "dev:api": "pnpm --filter @digitalwallet/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run db:validate && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
