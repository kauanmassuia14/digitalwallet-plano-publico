{
  "name": "@digitalwallet/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prebuild": "prisma generate --config prisma.config.ts",
    "pretypecheck": "prisma generate --config prisma.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "prisma validate --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "prisma": "7.8.0"
  }
}
